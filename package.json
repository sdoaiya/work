{
  "name": "ai-workdock",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm --workspaces --if-present test",
    "build": "npm --workspaces --if-present run build",
    "dev:admin": "npm --workspace apps/admin-web run dev",
    "dev:desktop": "npm --workspace apps/desktop run dev"
  }
}
