{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI WorkDock",
  "version": "0.1.0",
  "identifier": "local.ai-workdock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI WorkDock",
        "width": 420,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
